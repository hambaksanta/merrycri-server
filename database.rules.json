{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['nickname', 'friendCode', 'createdAt'])",
        "nickname": {
          ".validate": "newData.isString() && newData.val().length >= 1"
        },
        "friendCode": {
          ".validate": "newData.isString() && newData.val().length === 6 && (!data.exists() || newData.val() === data.val())"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === now) || (data.exists() && newData.val() === data.val()))"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "friendCodes": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && $code.length === 6 && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "!newData.exists() || (newData.isString() && newData.val() === auth.uid)"
      }
    },

    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friendUid": {
          ".write": "auth != null && $uid !== $friendUid && (auth.uid === $uid || auth.uid === $friendUid) && !data.exists() && newData.exists() && root.child('users').child($uid).exists() && root.child('users').child($friendUid).exists()",
          ".validate": "newData.isNumber() && newData.val() === now"
        }
      }
    },

    "ornaments": {
      "$ownerUid": {
        ".read": "auth != null",
        ".indexOn": ["createdAt"],
        "$writerUid": {
          ".write": "auth != null && auth.uid === $writerUid && $ownerUid !== $writerUid && !data.exists() && newData.exists() && root.child('friends').child($ownerUid).child($writerUid).exists()",
          ".validate": "newData.hasChildren(['type', 'slot', 'createdAt'])",
          "type": {
            ".validate": "newData.isString() && newData.val().matches(/^(bauble|star|cane|snow|gift|bell)$/)"
          },
          "slot": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 15"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },

    "letters": {
      "$recipientUid": {
        ".read": "auth != null && auth.uid === $recipientUid && root.child('config').child('openAt').isNumber() && now >= root.child('config').child('openAt').val()",
        ".indexOn": ["createdAt"],
        "$letterId": {
          ".write": "auth != null && ((!data.exists() && auth.uid !== $recipientUid && newData.child('senderUid').val() === auth.uid && root.child('friends').child($recipientUid).child(auth.uid).exists() && !root.child('ornaments').child($recipientUid).child(auth.uid).exists()) || (data.exists() && auth.uid === $recipientUid && root.child('config').child('openAt').isNumber() && now >= root.child('config').child('openAt').val()))",
          ".validate": "newData.hasChildren(['senderUid', 'senderNickname', 'content', 'ornamentType', 'createdAt', 'opened'])",
          "senderUid": {
            ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && newData.val() === data.val()))"
          },
          "senderNickname": {
            ".validate": "newData.isString() && newData.val().length >= 1 && ((!data.exists() && newData.val() === root.child('users').child(auth.uid).child('nickname').val()) || (data.exists() && newData.val() === data.val()))"
          },
          "content": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300 && (!data.exists() || newData.val() === data.val())"
          },
          "ornamentType": {
            ".validate": "newData.isString() && newData.val().matches(/^(bauble|star|cane|snow|gift|bell)$/) && (!data.exists() || newData.val() === data.val())"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === now) || (data.exists() && newData.val() === data.val()))"
          },
          "opened": {
            ".validate": "newData.isBoolean() && ((!data.exists() && newData.val() === false) || (data.exists() && data.val() === false && newData.val() === true))"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },

    "scores": {
      "$ownerUid": {
        ".read": "auth != null",
        ".indexOn": ["best"],
        "$writerUid": {
          ".write": "auth != null && auth.uid === $writerUid && root.child('ornaments').child($ownerUid).child($writerUid).exists() && (!data.exists() || newData.child('best').val() > data.child('best').val())",
          ".validate": "newData.hasChildren(['nickname', 'best', 'updatedAt'])",
          "nickname": {
            ".validate": "newData.isString() && newData.val().length >= 1"
          },
          "best": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },

    "config": {
      ".read": "auth != null",
      ".write": false,
      "openAt": {
        ".validate": "newData.isNumber()"
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
